{
  "domain": {
    "grid_size": 24,
    "n_regimes": 5,
    "regime_names": [
      "Active Monsoon",
      "Break Monsoon",
      "Monsoon Depression",
      "Orographic Rainfall",
      "Western Disturbance"
    ]
  },
  "data": {
    "n_seasons": 8,
    "season_length_days": 122,
    "test_seasons": 1,
    "seed": 42,
    "sample_dir": "data/sample"
  },
  "vae": {
    "latent_dim": 8,
    "epochs": 60,
    "batch_size": 32,
    "lr": 0.001,
    "beta": 0.5
  },
  "gmm": {
    "n_components": 5,
    "covariance_type": "full"
  },
  "subdaily": {
    "steps_per_day": 8,
    "wobble_std": 0.06
  },
  "unet": {
    "base_channels": 16,
    "dropout_p": 0.15,
    "epochs": 80,
    "batch_size": 16,
    "lr": 0.0005,
    "heavy_rain_weight_threshold_mm": 65.0,
    "heavy_rain_weight_factor": 4.0
  },
  "uncertainty": {
    "mc_dropout_passes": 50,
    "quantiles": [
      0.1,
      0.5,
      0.9
    ],
    "heavy_rain_threshold_mm": 100.0
  },
  "verification": {
    "thresholds_mm": [
      15,
      65,
      115
    ],
    "fss_neighborhood": 3
  },
  "paths": {
    "models_dir": "models",
    "outputs_dir": "outputs"
  }
}